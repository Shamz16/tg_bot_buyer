# Telegram Configuration
BOT_TOKEN=your_bot_token_here
API_ID=your_api_id_here
API_HASH=your_api_hash_here
PHONE_NUMBER=+1234567890
SESSION_NAME=gift_buyer_session

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tg_gifts
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your_secret_key_here
OPERATOR_USER_IDS=123456789,987654321  # Comma-separated Telegram user IDs

# Limits & Safety
MAX_SPEND_PER_DAY=10000  # In Stars
MAX_PURCHASES_PER_HOUR=10
DEFAULT_POLLING_INTERVAL=5  # Seconds
FAST_POLLING_INTERVAL=1  # For time-sensitive drops

# Environment
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO
TIMEZONE=UTC